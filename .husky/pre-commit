#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only)

echo "Running oxfmt and oxlint..."
pnpm run format:check
if [ $? -ne 0 ]; then
	echo "Format check failed. Run 'pnpm run format' to fix."
	exit 1
fi

pnpm run lint
if [ $? -ne 0 ]; then
	echo "Lint failed."
	exit 1
fi

echo "Running type checking and fast tests..."
pnpm run typecheck && pnpm run test:precommit
if [ $? -ne 0 ]; then
	echo "Checks failed."
	exit 1
fi

for file in $STAGED_FILES; do
	if [ -f "$file" ]; then
		git add "$file"
	fi
done

echo "Pre-commit checks passed."
