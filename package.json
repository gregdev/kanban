{
	"name": "kanban",
	"version": "0.1.70",
	"description": "A kanban foundation for coding agents",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"kanban",
		"agents",
		"cli",
		"task-management",
		"typescript"
	],
	"homepage": "https://github.com/cline/kanban",
	"bugs": {
		"url": "https://github.com/cline/kanban/issues"
	},
	"author": "Cline",
	"repository": {
		"type": "git",
		"url": "https://github.com/cline/kanban"
	},
	"type": "module",
	"bin": {
		"kanban": "dist/cli.js"
	},
	"man": "./man/kanban.1",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"man",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"clean": "shx rm -rf dist coverage",
		"build": "pnpm run clean && pnpm run web:build && node scripts/build.mjs && shx mkdir -p dist/web-ui && shx cp -r web-ui/dist/* dist/web-ui && node scripts/upload-sentry-sourcemaps.mjs && shx chmod +x dist/cli.js",
		"dogfood": "node scripts/dogfood.mjs",
		"link": "pnpm run build && pnpm add --global .",
		"unlink": "pnpm remove --global kanban",
		"dev": "NODE_ENV=development tsx watch src/cli.ts",
		"dev:full": "node scripts/dev-full.mjs",
		"web:dev": "pnpm --filter @kanban/web run dev",
		"web:build": "pnpm --filter @kanban/web run build",
		"web:typecheck": "pnpm --filter @kanban/web run typecheck",
		"web:test": "pnpm --filter @kanban/web run test",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "oxlint src test web-ui/src web-ui/tests vitest.config.ts web-ui/vite.config.ts web-ui/vitest.config.ts web-ui/playwright.config.ts",
		"format": "oxfmt --write src test scripts web-ui/src web-ui/tests web-ui/vite.config.ts web-ui/vitest.config.ts web-ui/vitest.setup.ts web-ui/playwright.config.ts vitest.config.ts",
		"format:check": "oxfmt --check src test scripts web-ui/src web-ui/tests web-ui/vite.config.ts web-ui/vitest.config.ts web-ui/vitest.setup.ts web-ui/playwright.config.ts vitest.config.ts",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test:all",
		"test": "pnpm run test:fast",
		"test:all": "vitest run",
		"test:fast": "vitest run test/runtime test/utilities",
		"test:integration": "vitest run test/integration",
		"test:precommit": "pnpm run test:fast",
		"test:watch": "vitest",
		"prepare": "husky",
		"prepublishOnly": "pnpm run build && pnpm run check"
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@sentry/cli": "^3.3.3",
		"@types/node": "^22.10.5",
		"@types/proper-lockfile": "^4.1.4",
		"@types/ws": "^8.18.1",
		"esbuild": "^0.28.1",
		"husky": "^9.1.7",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"shx": "^0.4.0",
		"tsx": "^4.20.3",
		"typescript": "7.1.0-beta",
		"vite": "^6.4.2",
		"vitest": "^5.1.1"
	},
	"optionalDependencies": {
		"@rolldown/binding-linux-x64-gnu": "1.0.0-rc.9"
	},
	"dependencies": {
		"@clinebot/core": "^0.0.38",
		"@clinebot/shared": "^0.0.38",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@sentry/node": "^10.45.0",
		"@trpc/client": "^11.11.0",
		"@trpc/server": "^11.11.0",
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/headless": "^6.0.0",
		"commander": "^14.0.3",
		"node-pty": "^1.2.0-beta.11",
		"open": "^11.0.0",
		"ora": "^9.3.0",
		"proper-lockfile": "^4.1.2",
		"tree-kill": "^1.2.2",
		"undici": "^6.27.0",
		"ws": "^8.21.0",
		"zod": "^4.3.6"
	}
}
