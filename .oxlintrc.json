{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "env": {
    "es2022": true,
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "coverage/**", ".worktrees/**", "**/node_modules/**"],
  "rules": {
    "eslint/prefer-const": "error",
    "eslint/no-template-curly-in-string": "error",
    "typescript/no-explicit-any": "off",
    "react/immutability": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/static-components": "off"
  },
  "overrides": [
    {
      "files": ["test/**", "vitest.config.ts"],
      "env": {
        "vitest": true
      }
    },
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludeFiles": ["src/cli.ts"],
      "rules": {
        "eslint/no-console": "error",
        "unicorn/no-process-exit": "error"
      }
    },
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludeFiles": ["src/cline-sdk/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@clinebot/core", "@clinebot/core/**"],
                "message": "Import Cline SDK packages only through src/cline-sdk/sdk-provider-boundary.ts or src/cline-sdk/sdk-runtime-boundary.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["web-ui/**/*.ts", "web-ui/**/*.tsx"],
      "env": {
        "browser": true,
        "vitest": true
      },
      "rules": {
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/heading-has-content": "off",
        "jsx-a11y/interactive-supports-focus": "off",
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/role-has-required-aria-props": "off",
        "react/exhaustive-deps": "off",
        "react/jsx-fragments": "off",
        "react/no-array-index-key": "off",
        "react/no-danger": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["web-ui/src/**/*.ts", "web-ui/src/**/*.tsx"],
      "excludeFiles": [
        "web-ui/src/runtime/runtime-config-query.ts",
        "web-ui/src/runtime/workspace-state-query.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/runtime/trpc-client",
                "importNames": ["createWorkspaceTrpcClient"],
                "message": "Use getRuntimeTrpcClient in components and hooks. Reserve createWorkspaceTrpcClient for the runtime query helpers."
              }
            ]
          }
        ]
      }
    }
  ]
}
